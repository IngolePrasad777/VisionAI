# Server
server.port=8081

# MongoDB — replace with your Atlas URI
spring.data.mongodb.uri=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/visioncheck?retryWrites=true&w=majority

# ML Microservice URL
ml.service.url=http://localhost:5000

# JWT — use a strong random secret (min 256 bits)
jwt.secret=your-secret-key-here-must-be-at-least-256-bits-long
jwt.expiration=86400000

# CORS
cors.allowed.origins=http://localhost:3000

# Logging
logging.level.com.visioncheck=DEBUG

# Ishihara plates base path (relative to backend working directory)
plates.base-path=../
